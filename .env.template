# .env.template — KPOP JOURNAL 環境変数テンプレート(M11.5.B)
#
# 使い方: このファイルを .env にコピーし、各値を実際の認証情報で埋める。
#         .env は .gitignore 済(コミットしないこと)。値は秘匿。
#         config/discord_webhooks.json はこの .env の DISCORD_WEBHOOK_* を
#         プレースホルダー経由で参照する(実URLを config に書かない)。

# --- WordPress ---
WP_USER=
WP_PASS=
SITE_URL=
GSC_SITE_URL=

# --- AdSense / 収益 ---
ADSENSE_ACCOUNT_NAME=

# --- 機能フラグ ---
ENABLE_X_POST=
ENABLE_TOKEN_TRACKING=

# --- Discord Webhook(チャンネル別。Discord でウェブフック作成→URLを貼る) ---
# 旧来の汎用フォールバック(任意):
DISCORD_WEBHOOK=
# チャンネル別(config/discord_webhooks.json のプレースホルダーに対応):
DISCORD_WEBHOOK_DAILY_CEO=
DISCORD_WEBHOOK_WEEKLY_BOARD=
DISCORD_WEBHOOK_MONTHLY_BOARD=
DISCORD_WEBHOOK_URGENT_ERRORS=
DISCORD_WEBHOOK_SEO_INSIGHTS=
DISCORD_WEBHOOK_PUBLISHING_LOG=
DISCORD_WEBHOOK_SALES_MONETIZATION=
DISCORD_WEBHOOK_ALERT_SUMMARY=
